---
import Basis from './Basis.astro';
import Hero from '../components/Hero.astro';
import { berichte, link, url, type Bericht } from '../lib';

interface Props { bericht: Bericht }
const { bericht } = Astro.props;
const d = bericht.data;

// Etappen-Navigation: vorherige/nächste Region derselben Reise
const etappen = (await berichte()).filter((b) => b.data.reise === d.reise);
const i = etappen.findIndex((b) => b.id === bericht.id);
const vor = etappen[i - 1], nach = etappen[i + 1];
---
<Basis titel={d.titel} beschreibung={d.untertitel} bild={d.titelbild} typ="article">
  <article>
    <Hero bild={d.titelbild} kicker={d.kicker} titel={d.titel} untertitel={d.untertitel} />
    {d.entwurf && <p class="textwrap"><span class="tag-draft">Entwurf – nicht veröffentlicht</span></p>}

    <section class="iintro textwrap">
      {d.teaser.map((t) => <p>{t}</p>)}
    </section>
    {d.highlights.length > 0 && (
      <ul class="itiles wrap">
        {d.highlights.map((h) => (
          <li><img src={h.bild} alt="" loading="lazy" /><span>{h.text}</span></li>
        ))}
      </ul>
    )}

    <div class="prose"><slot /></div>

    {(vor || nach) && (
      <nav class="etappen wrap" aria-label="Etappen">
        {vor ? <a class="etappe" href={link(vor)}><img src={vor.data.titelbild} alt="" loading="lazy" /><span>← {vor.data.titel}</span></a> : <span />}
        {nach && <a class="etappe nach" href={link(nach)}><img src={nach.data.titelbild} alt="" loading="lazy" /><span>{nach.data.titel} →</span></a>}
      </nav>
    )}
  </article>
</Basis>

<style is:global>
  .iintro { margin-block: 2.5rem 1.5rem; font-size: 1.15rem; }
  .itiles { list-style: none; padding: 0 16px; display: grid; gap: .75rem; grid-template-columns: repeat(2, 1fr); margin-block: 0 3rem; }
  @media (min-width: 800px) { .itiles { grid-template-columns: repeat(4, 1fr); } }
  .itiles li { display: flex; flex-direction: column; gap: .4rem; font-size: .9rem; color: var(--muted); }
  .itiles img { aspect-ratio: 4 / 3; object-fit: cover; border-radius: 8px; width: 100%; }
  .prose > :is(p, h2, h3, ul, ol, blockquote) { max-width: var(--textw); margin-inline: auto; padding-inline: 16px; }
  .prose > p > img { border-radius: 8px; }
  .prose > .map { max-width: var(--maxw); margin: 2rem auto; width: calc(100% - 32px); }
  .etappen { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 4rem; }
  .etappe { position: relative; display: block; border-radius: var(--radius); overflow: hidden; color: #fff; text-decoration: none; background: #000; }
  .etappe img { aspect-ratio: 16 / 9; object-fit: cover; width: 100%; opacity: .7; }
  .etappe span { position: absolute; left: .8rem; bottom: .6rem; right: .8rem; font-weight: 600; }
  .etappe.nach { text-align: right; }
</style>
