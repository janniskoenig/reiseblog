---
import '../styles/global.css';
import { url } from '../lib';

interface Props { titel: string; beschreibung?: string; bild?: string; noindex?: boolean }
const { titel, beschreibung = 'Reise- und Outdoor-Blog', bild, noindex = false } = Astro.props;
const seitenname = 'Reiseblog'; // TODO: Namen deines Blogs eintragen
const pfad = Astro.url.pathname;
const nav = [
  { href: url('/'), text: 'Start' },
  { href: url('/berichte/'), text: 'Berichte' },
  { href: url('/karte/'), text: 'Karte' },
  { href: url('/dashboard/'), text: 'Dashboard' },
];
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titel === seitenname ? titel : `${titel} · ${seitenname}`}</title>
    <meta name="description" content={beschreibung} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschreibung} />
    {bild && <meta property="og:image" content={new URL(bild, Astro.site)} />}
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <script is:inline>
      // Stabile Viewport-Höhe (--vh): wächst mit dem Fenster, ignoriert das
      // kurze Schrumpfen durch die einblendende Browserleiste am Handy.
      (() => {
        let w = innerWidth, h = innerHeight;
        const set = () => document.documentElement.style.setProperty('--vh', h / 100 + 'px');
        set();
        addEventListener('resize', () => {
          if (innerWidth !== w || innerHeight > h + 20) { w = innerWidth; h = innerHeight; set(); }
        });
        const check = () => { if (innerHeight > h + 20) { h = innerHeight; set(); dispatchEvent(new Event('resize')); } };
        addEventListener('load', check); setTimeout(check, 800);
      })();
    </script>
  </head>
  <body>
    <header class="site-head">
      <div class="wrap">
        <a class="logo" href={url('/')}>{seitenname}</a>
        <nav class="nav" aria-label="Hauptnavigation">
          {nav.map((n) => (
            <a href={n.href} aria-current={(n.href === url('/') ? pfad === n.href : pfad.startsWith(n.href)) ? 'page' : undefined}>{n.text}</a>
          ))}
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-foot">
      <div class="wrap">
        © {new Date().getFullYear()} {seitenname}{' · '}
        <a href={url('/kontakt/')}>Kontakt</a>{' · '}
        <a href={url('/impressum/')}>Impressum</a>{' · '}
        <a href={url('/datenschutz/')}>Datenschutz</a>
      </div>
    </footer>
  </body>
</html>
