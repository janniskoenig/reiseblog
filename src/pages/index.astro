---
// Startseite: Touren-Dashboard (Karte, Filter, Zeitleiste) und darunter die Berichte.
// Die Berichtskarten tragen data-tour und werden von den Dashboard-Filtern mitgefiltert.
import Basis from '../layouts/Basis.astro';
import TourenDashboard from '../components/TourenDashboard.astro';
import daten from '../data/touren.json';
import { berichte, link, reisen, url, zeigeEntwuerfe } from '../lib';

const alle = await berichte();
const arten = daten.arten as Record<string, string>;
// Kurztexte für Touren, deren Seite nicht aus einem Bericht-Steckbrief (.mdx) kommt
const EXTRA: Record<string, { titel: string; text: string; bild?: string; planung?: string }> = {
  madagaskar: { titel: reisen[0].name, text: reisen[0].text, bild: reisen[0].bild, planung: reisen[0].planung },
  alpencross: { titel: 'MTB-Alpencross', text: 'In acht Etappen mit dem Mountainbike von Füssen über Landeck, das Münstertal und Madonna di Campiglio bis an den Gardasee.' },
};

const artikel = daten.touren.filter((t) => t.bericht && (zeigeEntwuerfe || !t.entwurf)).map((t) => {
  const seite = url(t.bericht!);
  // Steckbriefe, die auf diese Tour verweisen (Madagaskar: fünf Regionen, Alta Via: einer)
  const teile = alle.filter((b) => link(b).startsWith(seite));
  const haupt = teile.length === 1 ? teile[0] : undefined;
  const extra = EXTRA[t.id];
  return {
    tour: t,
    link: seite,
    titel: extra?.titel ?? haupt?.data.titel ?? t.name,
    text: extra?.text ?? haupt?.data.teaser[0] ?? '',
    bild: extra?.bild ?? haupt?.data.titelbild,
    planung: extra?.planung,
    teile: teile.length > 1 ? teile : [],
    jahr: t.start.slice(0, 4),
  };
}).sort((a, b) => b.tour.start.localeCompare(a.tour.start));

// Mini-Karte als Ersatz, wenn es noch kein Titelbild gibt
import spuren from '../../public/touren/spuren.json';
function vorschau(id: string) {
  const linien = (spuren as Record<string, [number, number][][]>)[id] || [];
  const p = linien.flat();
  if (!p.length) return '';
  const la = p.map((x) => x[0]), lo = p.map((x) => x[1]);
  const k = Math.cos(((Math.min(...la) + Math.max(...la)) / 2) * Math.PI / 180);
  const w = 300, h = 200, rand = 18;
  const ex = (Math.max(...lo) - Math.min(...lo)) * k, ey = Math.max(...la) - Math.min(...la);
  const sc = Math.min((w - 2 * rand) / ex, (h - 2 * rand) / ey);
  const ox = (w - ex * sc) / 2, oy = (h - ey * sc) / 2;
  const d = linien.map((l) => l.map(([a, b], i) => `${i ? 'L' : 'M'}${(ox + (b - Math.min(...lo)) * k * sc).toFixed(1)} ${(oy + (Math.max(...la) - a) * sc).toFixed(1)}`).join('')).join('');
  return `<svg viewBox="0 0 ${w} ${h}" aria-hidden="true"><path d="${d}" /></svg>`;
}
---
<Basis titel="Reiseblog" beschreibung="Reise- und Outdoor-Berichte mit Karten und Bildern: Wandern, Rad, Hochtouren und Reisen seit 2023.">
  <section class="intro wrap">
    <h1>Unterwegs</h1>
    <!-- TODO: ein, zwei Sätze über dich und den Blog -->
    <p class="muted">Alle Touren seit 2023 auf einer Karte. Filtern nach Art, Region und Jahr, darunter die Berichte.</p>
  </section>

  <div class="wrap">
    <TourenDashboard />
  </div>

  <section class="wrap berichte">
    <h2>Berichte</h2>
    <div class="cards">
      {artikel.map((a) => (
        <article class="card artikel" data-tour={a.tour.id}>
          <a class="artikel-bild" href={a.link} tabindex="-1" aria-hidden="true">
            {a.bild ? <img src={a.bild} alt="" loading="lazy" /> : <div class={`vorschau a-${a.tour.art}`} set:html={vorschau(a.tour.id)} />}
          </a>
          <div class="card-body">
            <div class="card-kicker">{arten[a.tour.art]} · {a.tour.gebiet} · {a.jahr} {a.tour.entwurf && <span class="tag-draft">Entwurf</span>}</div>
            <h3><a href={a.link}>{a.titel}</a></h3>
            <p>{a.text}</p>
            {a.teile.length > 0 && (
              <ul class="teile">
                {a.teile.map((b) => <li><a href={link(b)}>{b.data.titel}</a></li>)}
              </ul>
            )}
            <p class="mehr"><a href={a.link}>Zum Bericht →</a>{a.planung && <> · <a href={a.planung}>Reiseplanung</a></>}</p>
          </div>
        </article>
      ))}
    </div>
    <p class="muted" data-tour-leer hidden>Zu dieser Auswahl gibt es noch keinen Bericht. Die Touren stehen trotzdem auf der Karte und in der Zeitleiste.</p>
  </section>
</Basis>
<style>
  .intro { padding-block: 2.5rem .75rem; }
  .intro h1 { font-size: clamp(2rem, 6vw, 3.2rem); margin: 0 0 .4rem; }
  .intro p { margin: 0; }
  .berichte { margin-top: 2.5rem; }
  .artikel-bild img, .vorschau { aspect-ratio: 3 / 2; width: 100%; }
  .vorschau { background: var(--bg); display: grid; place-items: center; border-bottom: 1px solid var(--line); }
  .vorschau :global(svg) { width: 100%; height: 100%; }
  .vorschau :global(path) { fill: none; stroke: var(--c, var(--accent)); stroke-width: 3; stroke-linejoin: round; stroke-linecap: round; }
  .vorschau.a-wandern { --c: #2f7d5b; } .vorschau.a-rad { --c: #2a6fc9; } .vorschau.a-schnee { --c: #7a5cc9; } .vorschau.a-reise { --c: #c0821a; }
  .artikel h3 a { color: inherit; text-decoration: none; }
  .artikel h3 a:hover { text-decoration: underline; }
  .teile { margin: .6rem 0 0; padding-left: 1.1rem; font-size: .92rem; }
  .mehr { margin-top: .7rem !important; }
  .card[hidden] { display: none; }
</style>
