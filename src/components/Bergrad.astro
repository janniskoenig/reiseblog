---
// Das Zeichen des Blogs: Bergsilhouette als Fahrradrahmen über zwei Rädern.
// Farben über --logo-rot / --logo-gruen (global.css), passt sich dem Dunkelmodus an.
interface Props { class?: string }
const { class: klasse } = Astro.props;
---
<svg class={klasse} viewBox="8 26 106 82" aria-hidden="true" focusable="false">
  <g fill="none" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="30" cy="86" r="20" style="stroke: var(--logo-gruen)" />
    <circle cx="92" cy="86" r="20" style="stroke: var(--logo-gruen)" />
    <path d="M30 86 L52 40 L64 58 L76 30 L92 86" style="stroke: var(--logo-rot)" />
  </g>
</svg>
